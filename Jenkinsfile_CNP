#!groovy

@Library("Infrastructure@fix/library-branch-validation-rate-limit")
import uk.gov.hmcts.contino.GithubAPI

// Temporary PR smoke test on a non-sandbox Jenkins controller; stop before deployment.
if (env.CHANGE_ID) {
  def github = new GithubAPI(this)
  assert github.tagExists('hmcts/cnp-jenkins-library', '2.11.1')
  assert !github.tagExists('hmcts/cnp-jenkins-library', '999.999.999')
  echo 'Authenticated tag lookup smoke test passed before checkout.'
  return
}

def type = "nodejs"
def product = "plum"
def component = "frontend" 
def expiresAfter = "3000-01-01"

def secrets = [ 'plumsi-${env}':
  [
    secret('AppInsightsInstrumentationKey', 'APPINSIGHTS_INSTRUMENTATIONKEY')
  ]
]

static LinkedHashMap<String, Object> secret(String secretName, String envVar) {
  [ $class: 'AzureKeyVaultSecret',
    secretType: 'Secret',
    name: secretName,
    version: '',
    envVariable: envVar
  ]
}

def yarnBuilder = new uk.gov.hmcts.contino.YarnBuilder(this)

withPipeline(type, product, component) {
  loadVaultSecrets(secrets)
  disableLegacyDeployment()
  expires(expiresAfter)

  afterAlways('build') {
    yarnBuilder.yarn('rebuild puppeteer')
    yarnBuilder.yarn('build')
  }

  before('functionalTest:preview') {
    sh """
      PUPPETEER_SKIP_DOWNLOAD=true yarn install
      yarn playwright install
    """
  }

  before('functionalTest:aat') {
    sh """
      PUPPETEER_SKIP_DOWNLOAD=true yarn install
      yarn playwright install
    """
  }

  before('functionalTest:perftest') {
    sh """
      PUPPETEER_SKIP_DOWNLOAD=true yarn install
      yarn playwright install
    """
  }

  before('smoketest:preview') {
    sh 'PUPPETEER_SKIP_DOWNLOAD=true yarn install'
  }

  before('smoketest:aat') {
    sh 'PUPPETEER_SKIP_DOWNLOAD=true yarn install'
  }

}
